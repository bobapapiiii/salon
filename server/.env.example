# Copy to .env for local dev. On Render, these are set as environment
# variables on the Web Service (DATABASE_URL is injected automatically
# when you attach the managed Postgres via render.yaml).

# Postgres connection string. Render's managed Postgres gives you this
# on its "Connect" tab (use the "External Database URL" from your own
# machine, the internal one when the API runs on Render itself).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gloss_nail_bar

# Long random string used to sign staff login JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser.
# Include your Vite dev server and your deployed frontend URL.
CORS_ORIGINS=http://localhost:5173

PORT=8080
