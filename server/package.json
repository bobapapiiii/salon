{
  "name": "gloss-nail-bar-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Gloss Nail Bar -- public online booking + staff auth/approval.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:import-local": "tsx src/db/import-local-data.ts",
    "db:create-staff-login": "tsx src/db/create-staff-logins.ts",
    "db:cleanup-demo-seed": "tsx src/db/cleanup-demo-seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
